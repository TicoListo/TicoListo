# Supabase: use the pooler connection string in production.
# Convert postgresql:// to postgresql+asyncpg:// for SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Comma-separated public frontend origins. Same-origin requests do not
# require CORS, but keep the Vercel URL for browser integrations.
CORS_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-DOMAIN.vercel.app

# Replace this before deploying the admin panel.
ADMIN_API_KEY=replace-with-a-long-random-secret
