{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/index.py?path=auth/:path*"
    },
    {
      "source": "/api/me/:path*",
      "destination": "/api/index.py?path=me/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index.py?path=admin/:path*"
    },
    {
      "source": "/api/site-config/:path*",
      "destination": "/api/index.py?path=site-config/:path*"
    },
    {
      "source": "/api/chat/:path*",
      "destination": "/api/index.py?path=chat/:path*"
    },
    {
      "source": "/api/chat-token/:path*",
      "destination": "/api/index.py?path=chat-token/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?path=:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  }
}
