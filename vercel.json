{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index.py?path=admin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?path=:path*"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  }
}
