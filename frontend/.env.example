# Public API URL. For the single-project Vercel deployment, use /api.
NEXT_PUBLIC_API_URL=/api

# Absolute URL used by server-side SEO pages and the sitemap.
API_SERVER_URL=https://YOUR-VERCEL-DOMAIN.vercel.app/api

# Public canonical URL used by metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
